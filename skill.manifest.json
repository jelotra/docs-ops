{
  "schema_version": "1.0",
  "name": "docs-ops",
  "kind": "capability",
  "layer": "generic",
  "version": "0.4.0",
  "summary": "文档体系多 lane 统一入口：docs-system（正文/历史分层、模板、结构检查、残留检测 pattern/dirList/deadLinks/generatedDrift + ledger 提取 + 守卫铸造）+ demand-lifecycle（需求文档结构检查、状态视图、验收编号门禁）。两 lane 契约与引擎隔离，互不误伤。",
  "entrypoints": [
    "SKILL.md",
    "references/workflow/node-flow.json",
    { "command": "check", "argv": ["python", "scripts/docs-ops.py", "check", "--project", "<项目>"] },
    { "command": "demand", "argv": ["python", "scripts/docs-ops.py", "demand", "--project", "<项目>"] },
    { "command": "new", "argv": ["python", "scripts/docs-ops.py", "new", "--type", "body-doc", "--out", "<路径>"] },
    { "command": "migrate", "argv": ["python", "scripts/docs-ops.py", "migrate", "--file", "<旧文档>"] },
    { "command": "residue", "argv": ["python", "scripts/docs-ops.py", "residue", "--project", "<项目>"] }
  ],
  "tests": {
    "paths": ["tests"],
    "runner": "pytest"
  },
  "budgets": {},
  "interfaces": {
    "provides": [
      "doc-system-layering",
      "doc-templates",
      "residue-detection",
      "residue-ledger",
      "residue-mint",
      "demand-structure",
      "demand-status-mapping",
      "demand-structure-guard"
    ],
    "consumes": ["report-output-v1"]
  },
  "depends_on": {
    "tools": [],
    "skills": ["skills-runtime-toolkit"]
  },
  "owner": "docs-ops",
  "status": "active"
}
