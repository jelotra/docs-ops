{
  "schema_version": "1.0",
  "name": "je-docs-ops",
  "kind": "capability",
  "layer": "generic",
  "version": "0.2.0",
  "summary": "项目文档体系规范与残留检测统一入口：前置（正文/历史分层、模板、结构检查）+ 后置（语言无关残留检测引擎 pattern/dirList/deadLinks/generatedDrift + ledger 提取 + 守卫铸造）",
  "entrypoints": [
    "SKILL.md",
    "references/workflow/node-flow.json",
    { "command": "check", "argv": ["python", "scripts/je-docs-ops.py", "check", "--project", "<项目>"] },
    { "command": "new", "argv": ["python", "scripts/je-docs-ops.py", "new", "--type", "body-doc", "--out", "<路径>"] },
    { "command": "migrate", "argv": ["python", "scripts/je-docs-ops.py", "migrate", "--file", "<旧文档>"] },
    { "command": "residue", "argv": ["python", "scripts/je-docs-ops.py", "residue", "--project", "<项目>"] }
  ],
  "tests": {
    "paths": ["tests"],
    "runner": "pytest"
  },
  "budgets": {},
  "interfaces": {
    "provides": [
      "doc-system-layering",
      "doc-templates",
      "residue-detection",
      "residue-ledger",
      "residue-mint"
    ],
    "consumes": ["report-output-v1"]
  },
  "depends_on": {
    "tools": [],
    "skills": ["skills-runtime-toolkit"]
  },
  "owner": "je-docs-ops",
  "status": "active"
}
