{
  "$doc": "je-docs-ops 自身的文档结构契约：正文层仅 concepts/，历史层 docs/history/。",
  "bodyDir": "docs",
  "historyDir": "docs/history",
  "historyIndex": "docs/history/README.md",
  "allowedDirs": ["concepts"],
  "indexFiles": ["docs/README.md", "docs/index.md"],
  "historyLinkExempt": [],
  "historyLinkRegex": "\\[[^\\]]*\\]\\(([^)\\s]*history[^)\\s]*)\\)",
  "historyLinkWhy": "正文层文档缺少「历史档案」跳转位（正文不写历史，只留跳转）",
  "historyLinkSeverity": "error",
  "roadmapFiles": [],
  "roadmapPastPatterns": [],
  "roadmapWhy": "roadmap 只写未来方向，不得含过去时措辞/时点数据",
  "bodyPastPatterns": ["\\b20\\d{2}-\\d{2}-\\d{2}\\b", "\\b\\d+\\s+passed\\b", "已交付", "本轮", "首轮", "上轮", "上次交付", "当前基线"],
  "bodyPastExemptRegex": "^\\s*>",
  "bodyPastWhy": "正文含过去时/时点措辞（会过期的内容应进历史层，正文只写当前是什么）",
  "bodyPastSeverity": "error"
}
