{
  "description": "docs-ops 的节点与链路契约。两个 lane 各一个节点，节点内以 modules 表达内聚子模块（层次同时落在目录结构与本契约），不平铺。nodes 只讲方法与门禁。",
  "lanes": {
    "docs-system": {
      "nodes": ["n01-doc-system"],
      "when": "新建或改造项目文档体系、写正文文档、归档历史、跑残留门禁",
      "engine": "structure_check.py + residue.py",
      "contract": "docs/doc-contract.json"
    },
    "demand-lifecycle": {
      "nodes": ["n02-demand"],
      "when": "新建需求、整理需求目录、对齐状态视图、跑需求结构门禁",
      "engine": "demand_check.py",
      "contract": "docs/demand-contract.json"
    }
  },
  "nodes": {
    "n01-doc-system": {
      "readme": "nodes/n01-doc-system/README.md",
      "title": "文档体系：分层、正文规则、归档、后置门禁",
      "modules": [
        { "id": "architecture", "path": "nodes/n01-doc-system/architecture.md", "title": "文档架构分层：正文/历史两层目录契约" },
        { "id": "body-rules", "path": "nodes/n01-doc-system/body-rules.md", "title": "正文前置规范：现在时、无历史措辞、跳转位" },
        { "id": "archive-flow", "path": "nodes/n01-doc-system/archive-flow.md", "title": "归档流程：先 git mv 归档再重写" },
        { "id": "guard", "path": "nodes/n01-doc-system/guard.md", "title": "后置检测：残留检测能力与守卫接入" }
      ]
    },
    "n02-demand": {
      "readme": "nodes/n02-demand/README.md",
      "title": "需求文档体系：结构分类、状态映射、结构门禁",
      "modules": [
        { "id": "structure", "path": "nodes/n02-demand/structure.md", "title": "需求目录分类法：实体与视图分离" },
        { "id": "status", "path": "nodes/n02-demand/status.md", "title": "状态机与三套状态词归一" },
        { "id": "guard", "path": "nodes/n02-demand/guard.md", "title": "结构门禁：demand 检查器与两 lane 隔离" }
      ]
    }
  },
  "schema_version": 1
}
